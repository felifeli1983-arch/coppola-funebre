# ── Shop / e-commerce ───────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# The shop & admin degrade gracefully when these are empty (no crash):
# pages render "not configured" states until the keys are provided.

# Supabase (database + admin auth + product-image storage) — connect later
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS for admin writes. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (payments) — start in TEST mode, swap to live keys when ready
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional order emails) — connect later
RESEND_API_KEY=
# "From" address for order emails (must be a verified Resend domain)
ORDER_FROM_EMAIL=ordini@eredicoppola.com
# Staff address that receives the "new order" notification
ORDER_NOTIFY_EMAIL=info@eredicoppola.com

# Admin subdomain host (used by middleware to route the admin app)
ADMIN_HOST=admin.eredicoppola.com

# ── Contact form (already in use) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
